# ============================================================================
# CONFIGURAÇÃO DO AMBIENTE - Gerador de Flashcards AI
# ============================================================================
# Este arquivo contém as variáveis de ambiente necessárias para o aplicativo.
# IMPORTANTE: Nunca compartilhe este arquivo ou faça commit dele no Git!
# ============================================================================

# ----------------------------------------------------------------------------
# GOOGLE GEMINI AI - Geração de Flashcards
# ----------------------------------------------------------------------------
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
# Substitua "SUA_CHAVE_AQUI" pela sua chave real (começa com AIza...)
GEMINI_API_KEY=SUA_CHAVE_AQUI

# ----------------------------------------------------------------------------
# SUPABASE - Banco de Dados e Autenticação
# ----------------------------------------------------------------------------
# Essas variáveis já devem estar configuradas. Se não estiverem, obtenha em:
# https://supabase.com/dashboard/project/ixpkbgmrqftmokdyydsl/settings/api

VITE_SUPABASE_URL=https://ixpkbgmrqftmokdyydsl.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_SUPABASE_AQUI

# ============================================================================
# INSTRUÇÕES PARA DESENVOLVIMENTO LOCAL:
# 1. Obtenha sua chave do Gemini em: https://aistudio.google.com/app/apikey
# 2. Substitua "SUA_CHAVE_AQUI" pela chave real
# 3. Salve este arquivo
# 4. Reinicie o servidor (Ctrl+C e depois: npm run dev)
# ============================================================================

# ============================================================================
# INSTRUÇÕES PARA DEPLOY NA VERCEL:
# ============================================================================
# Após fazer o deploy na Vercel, você precisa configurar as variáveis de
# ambiente no painel da Vercel:
#
# 1. Acesse: https://vercel.com/seu-usuario/seu-projeto/settings/environment-variables
# 2. Adicione as seguintes variáveis:
#    - VITE_SUPABASE_URL (copie o valor acima)
#    - VITE_SUPABASE_ANON_KEY (copie o valor acima)
#    - GEMINI_API_KEY (copie sua chave do Gemini)
# 3. Clique em "Save" para cada variável
# 4. Faça um novo deploy ou aguarde o redeploy automático
#
# IMPORTANTE: Nunca faça commit do arquivo .env.local no Git!
# ============================================================================
